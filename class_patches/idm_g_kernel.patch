+/**
+ * [class_baryons] Tight-coupling closure for a photon collision term made of
+ * Thomson scattering (rate a = kappa') plus clumps (rate b = dmu_idm_g) whose
+ * kernel has quadrupole-regeneration coefficient cT and polarization-source
+ * coefficient cE. Solving the quasi-static l=2 temperature and polarization
+ * equations gives P0 = 2 s_2 shear / (8 - 4.8 r) with r = (a + cE b)/(a + b),
+ * and shear = (4/15)(theta + metric_shear) / D with
+ * D = (a + b) - 0.8 (a + cT b)/(8 - 4.8 r). Returns tau2 = 0.75/D (so that
+ * shear = 16/45 tau2 (...), reducing to 1/(a+b) for Thomson), its conformal
+ * time derivative given da, db, and p_over_shear = 2/(8 - 4.8 r).
+ */
+static void idm_g_kernel_closure(double a, double b, double da, double db,
+                                 double cT, double cE,
+                                 double * tau2, double * dtau2, double * p_over_shear) {
+  double s = a + b, ds = da + db;
+  double r = (a + cE*b)/s;
+  double dr = ((da + cE*db)*s - (a + cE*b)*ds)/s/s;
+  double m = 8. - 4.8*r, dm = -4.8*dr;
+  double n = a + cT*b, dn = da + cT*db;
+  double D = s - 0.8*n/m;
+  double dD = ds - 0.8*(dn*m - n*dm)/m/m;
+  *tau2 = 0.75/D;
+  *dtau2 = -0.75*dD/D/D;
+  *p_over_shear = 2./m;
+}
 #include "parallel.h"
 
 
